{
  "realm": "ojobpub",
  "displayName": "ojobpub publisher (local development)",
  "enabled": true,
  "registrationAllowed": false,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "clients": [
    {
      "clientId": "ojobpub-publisher",
      "name": "ojobpub publisher",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "local-dev-secret-not-for-production",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:8080/login/oauth2/code/oidc"],
      "webOrigins": ["http://localhost:8080"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8080/"
      }
    }
  ],
  "users": [
    {
      "username": "alice",
      "email": "alice@example.com",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Anders",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "alice", "temporary": false }]
    },
    {
      "username": "bob",
      "email": "bob@example.com",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Brun",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "bob", "temporary": false }]
    },
    {
      "username": "mallory",
      "email": "mallory@example.com",
      "emailVerified": false,
      "firstName": "Mallory",
      "lastName": "Unverified",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "mallory", "temporary": false }]
    }
  ]
}
