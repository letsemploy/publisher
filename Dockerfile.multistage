# The jar is plain Java and the same for every platform, so it is built once, on
# the builder's own platform: under QEMU the arm64 build took 333 s against 43 s
# native. Only the package stage below is per platform, and it runs nothing.
FROM --platform=$BUILDPLATFORM docker.io/maven:3-eclipse-temurin-27 AS build

WORKDIR /home/app/
COPY . .
RUN mvn -f pom.xml package -Dmaven.test.skip
RUN mv ./target/*.jar /app.jar

#
# Package stage
#
# No RUN here: the workflow sets up no QEMU, so a command in this stage would
# fail for the platform that is not the runner's.
FROM docker.io/eclipse-temurin:25-jre-alpine
COPY --from=build /app.jar /opt/app/
# Memory defaults for a small instance, measured in 512 MB and 1 GB containers
# (CLAUDE.md, "Memory"). Serial GC, pinned: the JVM would pick G1 from 2 GB up,
# which measured larger. The cap is half the container rather than a quarter, to
# leave the live set room to grow with the data, and the free ratios shrink the
# heap back to what is in use, so the larger cap costs nothing in steady state.
# Compact object headers shrink every object. Setting JAVA_TOOL_OPTIONS in a
# deployment replaces all of these.
ENV JAVA_TOOL_OPTIONS="-XX:+UseSerialGC -XX:MaxRAMPercentage=50 -XX:MinHeapFreeRatio=10 -XX:MaxHeapFreeRatio=30 -XX:ReservedCodeCacheSize=64m -XX:+UseCompactObjectHeaders"
EXPOSE 8080
ENTRYPOINT ["java","-jar","/opt/app/app.jar"]
